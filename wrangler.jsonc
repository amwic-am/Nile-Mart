{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nile-mart",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/uploads",
      "/uploads/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  }
}
